# Coral / LLM (required for agent loop)
CORAL_CONNECTION_URL=http://localhost:5555/devmode/example/sessionId/sse
MODEL_API_KEY=
MODEL_NAME=
MODEL_PROVIDER=

# --- Runtime mode ---
# true = isolated demonstration data (no Coral / tokens required)
# false = live Coral SQL + real compliance scanner
CORALSEC_USE_DEMO=false

# Repo root (for uv compliance scan)
CORALSEC_ROOT=..

# Coral CLI
CORAL_BIN=coral
CORAL_WORKDIR=..

# GitHub (required for repo-scoped Coral queries)
GITHUB_TOKEN=your-github-token
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo

# Notion (policy search via notion.search)
NOTION_TOKEN=your-notion-token

# Slack (channel discovery)
SLACK_BOT_TOKEN=your-slackbot-token
